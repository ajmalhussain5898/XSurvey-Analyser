# Copy this file to .env.local for local development with `vercel dev`.
# In production, set these under Vercel → Project Settings → Environment Variables instead.

# --- AI chat (Generate Insights Report tab) ---
GEMINI_API_KEY=AIza-your-key-here
# Optional — defaults to gemini-2.5-flash if not set.
# GEMINI_MODEL=gemini-2.5-flash

# --- Login / sessions ---
# Any long random string — used to sign login sessions. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-string

# --- First Admin account (you) ---
# On your first login with this exact email+password, the Admin account is
# created automatically — no manual database step needed. Change the password
# afterwards is not required but you can rotate it by changing this env var,
# ONLY if the user record hasn't already been created (i.e. before first login).
ADMIN_EMAIL=you@infinix.com
ADMIN_PASSWORD=choose-a-strong-password

# --- Storage ---
# Create an Upstash Redis database (Vercel dashboard → Storage → Create Database →
# "Upstash Redis", or install the Upstash integration from the Vercel Marketplace)
# and "Connect" it to this project. That automatically injects either
#   KV_REST_API_URL / KV_REST_API_TOKEN
# or
#   UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN
# (both names are supported). Nothing to add manually here — just connect the
# store in the dashboard, then redeploy.
# (Note: "Vercel KV" itself is deprecated — Upstash Redis is the current
# supported replacement and is what this project's api/ functions use.)
